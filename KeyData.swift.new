            KeyData("\u{0633}", secondary: "\u{06D2}"),
            KeyData("\u{064A}", secondary: "\u{0626}",  alternates: ["\u{06D2}"]),
            KeyData("\u{0628}"),
            KeyData("\u{0644}", alternates: ["\u{0644}\u{0627}", "\u{0644}\u{0623}", "\u{0644}\u{0625}", "\u{0644}\u{0622}", "\u{0644}\u{0627}\u{0670}"]),
            KeyData("\u{0627}", secondary: "\u{0627}\u{0670}", alternates: ["\u{0623}", "\u{0622}", "\u{0625}"]),
            KeyData("\u{062A}"),
            KeyData("\u{0646}"),
            KeyData("\u{0645}"),
            KeyData("\u{0643}", secondary: "\u{06AF}",  alternates: ["\u{06AF}"]),
            KeyData("\u{0637}", secondary: "\u{06BA}"),
        ],
        [
            KeyData("\u{0626}"),
            KeyData("\u{0621}"),
            KeyData("\u{0624}", alternates: ["\u{06DA}", "\u{06E8}"]),
            KeyData("\u{0631}", secondary: "\u{0691}",  alternates: ["\u{0691}"]),

    static let defaultLayer = KeyboardLayer(id: "default", rows: [
        [
            KeyData("\u{0636}", secondary: "\u{0679}"),
            KeyData("\u{0635}"),
            KeyData("\u{062B}", secondary: "\u{067E}"),

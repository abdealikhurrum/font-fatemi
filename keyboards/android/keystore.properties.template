# Copy this file to `keystore.properties` (which is git-ignored) and fill in the
# values for your release upload keystore. app/build.gradle reads it to sign the
# release build. If this file is absent, the release build is left unsigned so
# debug builds and CI still work.
#
# Create an upload keystore once with:
#   keytool -genkeypair -v -keystore ligacheh-upload.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias ligacheh
#
# Keep the .jks file and these passwords OUT of version control and backed up
# safely — losing the upload key requires a key reset with Google Play support.

storeFile=../ligacheh-upload.jks
storePassword=CHANGEME
keyAlias=ligacheh
keyPassword=CHANGEME
